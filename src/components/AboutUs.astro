---
const highlights = [
  {
    title: "Precision",
    subtitle: "You Can Trust",
    icon: "shield-check"
  },
  {
    title: "On-Time",
    subtitle: "Delivery",
    icon: "clock-3"
  },
  {
    title: "Competitive",
    subtitle: "Pricing",
    icon: "badge-dollar-sign"
  }
];
---

<section id="about-us" class="w-full bg-red-700 text-white overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-2">
    
    <div class="flex flex-col justify-center px-8 py-12 sm:px-12 md:px-16 lg:px-20">
      <span class="text-xs font-bold tracking-widest uppercase opacity-90 mb-3 block">
        ABOUT R&J MANUFACTURING
      </span>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight leading-tight mb-6">
        YOUR RELIABLE MANUFACTURING PARTNER IN MEXICO
      </h2>

      <p class="text-white/90 text-sm sm:text-base leading-relaxed mb-10 max-w-xl">
        At R&J Manufacturing de México, we help companies solve their production challenges with precision, efficiency and commitment. We combine advanced technology, skilled talent and a customer-first approach to deliver parts you can count on.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-white/20">
        {highlights.map((item) => (
          <div class="flex items-center gap-3">
            <div class="p-2 border-2 border-white/60 rounded-full flex-shrink-0 flex items-center justify-center">
              <i data-lucide={item.icon} class="w-6 h-6 text-white stroke-[2.4]" aria-hidden="true"></i>
            </div>
            <div class="text-xs font-bold uppercase tracking-wider leading-snug">
              <div>{item.title}</div>
              <div class="text-white/80 font-normal">{item.subtitle}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="relative w-full h-[200px] sm:h-[250px] lg:h-auto flex items-center justify-center overflow-hidden p-8">
      <img 
        src="../images/ubication.webp" 
        alt="R&J Manufacturing de México Facility" 
        class="max-w-full max-h-full h-auto w-auto object-contain object-center"
        loading="lazy"
      />
    </div>

  </div>
</section>